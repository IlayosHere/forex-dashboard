# Copy to terraform.tfvars and fill in.
project_id   = "your-gcp-project-id"
region       = "europe-west1"
github_repo  = "owner/forex-dashboard"

# After first apply, update this to the deployed UI URL (and any custom domain).
cors_origins = "https://forex-ui-xxxxx-ew.a.run.app"

runner_min_instances = 1
