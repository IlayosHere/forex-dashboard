# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=forex
POSTGRES_USER=forex
POSTGRES_PASSWORD=change_me_in_production

# ── FastAPI ───────────────────────────────────────────────────────────────────
# Constructed automatically by docker-compose from the Postgres vars above.
# Only override here if you are running the API outside of Docker Compose.
# DATABASE_URL=postgresql://forex:change_me_in_production@localhost:5432/forex

# Comma-separated list of origins the browser may call the API from.
# Dev:  http://localhost:3000
# Prod: your VPS domain or IP (e.g. http://165.22.1.2 or https://signals.example.com)
CORS_ORIGINS=http://localhost:3000

# ── Authentication ────────────────────────────────────────────────────────────
# Required. Random secret for signing JWTs (use: openssl rand -hex 32)
JWT_SECRET=change_me_to_a_random_secret

# Multi-user: JSON object mapping usernames to bcrypt password hashes.
# Generate a hash with:
#   python -c "from passlib.hash import bcrypt; print(bcrypt.hash('your-password'))"
# Example with 2 users:
AUTH_USERS={"admin":"$2b$12$REPLACE_HASH_1","trader":"$2b$12$REPLACE_HASH_2"}

# Legacy single-user (used only if AUTH_USERS is not set):
# AUTH_USERNAME=admin
# AUTH_PASSWORD_HASH=$2b$12$REPLACE_WITH_YOUR_BCRYPT_HASH

# ── Life Journal ──────────────────────────────────────────────────────────────
# Second-factor passphrase gate for /life, on top of the login above.
# Generate a hash with:
#   python -c "from passlib.hash import bcrypt; print(bcrypt.hash('your-passphrase'))"
LIFE_PASSWORD_HASH=$2b$12$REPLACE_WITH_YOUR_BCRYPT_HASH

# How long an unlock lasts before the passphrase must be re-entered (default: 12)
# LIFE_UNLOCK_EXPIRE_HOURS=12

# ── Runner ────────────────────────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# ── Next.js UI ────────────────────────────────────────────────────────────────
# Baked into the client bundle at build time.
# Dev:  http://localhost:8070  (calls the API directly)
# Prod: your public nginx URL  (e.g. http://165.22.1.2 — nginx proxies /api/ → api:8000)
NEXT_PUBLIC_API_URL=http://localhost:8070

# ── Research page ─────────────────────────────────────────────────────────────
# The Research page reads the private prop-pipeline repo. Use ONE of these.
# Local development: point at your clone (also lets you add ideas without GitHub).
# PROP_PIPELINE_LOCAL_DIR=~/Documents/prop-pipeline
# Production: a fine-grained GitHub token limited to the prop-pipeline repo
# (Contents: read and write). In Cloud Run it comes from Secret Manager.
# PROP_PIPELINE_GITHUB_TOKEN=github_pat_...
# PROP_PIPELINE_REPO=IlayosHere/prop-pipeline
# PROP_PIPELINE_BRANCH=main
